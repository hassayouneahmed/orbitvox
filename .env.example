# Copy to .env and fill in. Never commit .env.

# --- Who the assistant is ---
ASSISTANT_NAME=Orbit
# How it addresses you in its own lines ("One moment, Boss."). Blank = no title.
USER_TITLE=
# Personality: write it in persona.txt (see persona.example.txt). Optional.
# PERSONA_FILE=persona.txt
# Your own orb logo (SVG you trust). Blank = the built-in orb.
ORB_LOGO=

# --- Brain: claude | openrouter | openai ---
BRAIN=claude
# claude: uses your own Claude Code CLI login (install it and run `claude` once to log in).
CLAUDE_MODEL=sonnet
# Mode at start: web | vault
START_MODE=web
# Notes folder for vault mode (read only), e.g. your Obsidian vault. Blank = vault mode off.
VAULT_DIR=
# Browser for its own window: msedge | chrome
BROWSER=msedge

# openrouter: plain chat, no tools.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash

# openai: any OpenAI-compatible server, plain chat, no tools.
# Ollama: OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=llama3.2
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=

# --- Voice and audio ---
# Kokoro voice, e.g. bm_george, bm_lewis, af_heart
VOICE=bm_george
WHISPER_MODEL=small
# Part of the device name; blank = system default
MIC_DEVICE=
SPEAKER_DEVICE=
# Seconds of silence before it answers (raise if it cuts you off)
PAUSE_SECS=0.8
ORB_PORT=8765
